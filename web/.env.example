DATABASE_URL=postgres://resume:resume@127.0.0.1:54329/resume_skill
SESSION_SECRET=replace-with-at-least-32-random-bytes
EMAIL_FROM=resume@example.com
SMTP_URL=
SMS_PROVIDER=console
# Production SMS provider settings are required before enabling real SMS delivery.
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
MODEL_PROVIDER=glm
MODEL_API_KEY=
MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_NAME=glm-5.3
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.data/storage
APP_URL=http://127.0.0.1:3000
AUTH_MODE=anonymous_preview

# Production-like adapters. Keep secrets only in web/.env or the deployment secret store.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PAYMENT_PROVIDER=mock
MONITORING_DSN=
